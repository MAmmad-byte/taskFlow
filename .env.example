# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"

# Secret used to sign session tokens. Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Session lifetime in hours
SESSION_HOURS=12

# Display name shown in the sidebar and browser tab
NEXT_PUBLIC_APP_NAME="TaskFlow"
NEXT_PUBLIC_ORG_NAME="IT Services"

# Tasks due within this many hours are shown as "due soon" in the login alert
DEADLINE_WARNING_HOURS=48
